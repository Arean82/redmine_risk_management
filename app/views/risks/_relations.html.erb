<div class="contextual">
  <% if User.current.allowed_to?(:edit_risks, @risk.project) %>
    <%= toggle_link l(:button_add), 'new-relation-form', focus: 'relation_issue_to_id' %>
  <% end %>
</div>

<p><strong><%= l(:label_related_issues) %></strong></p>

<% if User.current.allowed_to?(:edit_risks, @risk.project) %>
  <%= form_tag(risk_issues_path(@risk), id: 'new-relation-form', remote: true, method: :post, style: 'display: none; margin-bottom: 10px;') do %>
    <%= l(:label_issue) %> #<%= text_field_tag 'issue_id', '', size: 10, id: 'relation_issue_to_id' %>
    <%= submit_tag l(:button_add) %>
    <%= toggle_link l(:button_cancel), 'new-relation-form' %>
  <% end %>
<% end %>

<% if @risk.issues.any? %>
  <table class="list issues">
    <thead>
      <tr>
        <th>#</th>
        <th><%= l(:field_project) %></th>
        <th><%= l(:field_tracker) %></th>
        <th><%= l(:field_subject) %></th>
        <th><%= l(:field_status) %></th>
        <th><%= l(:field_due_date) %></th>
        <th>Schedule Exposure</th>
        <th></th>
      </tr>
    </thead>
    <tbody>
      <% today = Date.today %>
      <% @risk.issues.each do |issue| %>
        <%
          days = issue.due_date ? (issue.due_date - today).to_i : nil
          badge_html = if issue.closed?
                         "<span style='color:#64748b;font-size:0.85em;'>Completed</span>"
                       elsif days.nil?
                         "<span style='color:#94a3b8;font-size:0.85em;'>No Due Date</span>"
                       elsif days <= -7
                         "<span style='background:#fee2e2;color:#dc2626;padding:2px 6px;border-radius:3px;font-size:0.8em;font-weight:bold;'>#{-days}d Overdue (CRITICAL)</span>"
                       elsif days < 0
                         "<span style='background:#ffedd5;color:#ea580c;padding:2px 6px;border-radius:3px;font-size:0.8em;font-weight:bold;'>#{-days}d Overdue</span>"
                       elsif days <= 3
                         "<span style='background:#fef9c3;color:#ca8a04;padding:2px 6px;border-radius:3px;font-size:0.8em;font-weight:bold;'>Due in #{days}d</span>"
                       else
                         "<span style='background:#dcfce7;color:#16a34a;padding:2px 6px;border-radius:3px;font-size:0.8em;font-weight:bold;'>On Track (#{days}d)</span>"
                       end
        %>
        <tr id="relation-<%= issue.id %>" class="hascontextmenu <%= cycle('odd', 'even') %>">
          <td class="id"><%= link_to issue.id, issue_path(issue) %></td>
          <td class="project"><%= link_to_project(issue.project) %></td>
          <td class="tracker"><%= issue.tracker.name %></td>
          <td class="subject"><%= link_to issue.subject, issue_path(issue) %></td>
          <td class="status"><%= issue.status.name %></td>
          <td class="due_date"><%= format_date(issue.due_date) if issue.due_date %></td>
          <td class="exposure"><%= badge_html.html_safe %></td>
          <td class="buttons">
            <% if User.current.allowed_to?(:edit_risks, @risk.project) %>
              <%= link_to l(:button_delete), risk_issue_path(@risk, issue), remote: true, method: :delete, data: { confirm: l(:text_are_you_sure) }, class: 'icon-only icon-del' %>
            <% end %>
          </td>
        </tr>
      <% end %>
    </tbody>
  </table>
<% else %>
  <p class="nodata"><%= l(:label_no_data) %></p>
<% end %>
