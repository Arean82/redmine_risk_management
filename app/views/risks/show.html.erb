<div class="contextual">
  <%= link_to 'PDF', risk_path(@risk, format: 'pdf'), class: 'icon icon-pdf' %>
  <%= link_to l(:button_edit), edit_risk_path(@risk), class: 'icon icon-edit' if User.current.allowed_to?(:edit_risks, @risk.project) %>
  <%= link_to l(:button_delete), risk_path(@risk), method: :delete, data: { confirm: l(:text_are_you_sure) }, class: 'icon icon-del' if User.current.allowed_to?(:delete_risks, @risk.project) %>
</div>

<h2><%= l(:label_risk) %> #<%= @risk.id %></h2>

<div class="issue risk details">
  <div class="subject">
    <h3><%= @risk.title %></h3>
  </div>

  <p class="author">
    <%= authoring @risk.created_at, @risk.user %>.
    <% if @risk.created_at != @risk.updated_at %>
      <%= l(:label_updated_time, time_tag(@risk.updated_at)).html_safe %>.
    <% end %>
  </p>

  <div class="attributes">
    <div class="splitcontent">
      <div class="splitcontentleft">
        <div class="status attribute">
          <div class="label"><%= l(:field_status) %>:</div>
          <div class="value">
            <span class="badge" style="background-color: #<%= @risk.risk_status.color_to_hex %>; color: #fff; padding: 2px 6px; border-radius: 3px;">
              <%= @risk.risk_status.name %>
            </span>
          </div>
        </div>
        <div class="category attribute">
          <div class="label"><%= l(:field_category) %>:</div>
          <div class="value"><%= @risk.category&.name || '-' %></div>
        </div>
        <div class="assigned-to attribute">
          <div class="label"><%= l(:field_assigned_to) %>:</div>
          <div class="value"><%= link_to_user(@risk.assigned_to) if @risk.assigned_to %></div>
        </div>
        <div class="due-date attribute">
          <div class="label"><%= l(:field_due_date) %>:</div>
          <div class="value"><%= format_date(@risk.due_date) if @risk.due_date %></div>
        </div>
        <div class="strategy attribute">
          <div class="label"><%= l(:field_strategy) %>:</div>
          <div class="value"><span class="badge" style="background: #eceff1; padding: 2px 6px; border-radius: 3px; font-weight: 500;"><%= @risk.strategy&.humanize %></span></div>
        </div>
      </div>
      <div class="splitcontentright">
        <div class="probability attribute">
          <div class="label"><%= l(:field_probability) %>:</div>
          <div class="value"><%= @risk.probability %></div>
        </div>
        <div class="impact attribute">
          <div class="label"><%= l(:field_impact) %>:</div>
          <div class="value"><%= @risk.impact %></div>
        </div>
        <div class="criticality attribute">
          <div class="label"><%= l(:field_criticality) %>:</div>
          <div class="value">
            <strong><%= @risk.criticality %></strong> (<%= @risk.rationale %>)
            <% case @risk.velocity_trend %>
            <% when 'escalated' %>
              <span style="color: #dc2626; font-size: 11px; font-weight: bold; margin-left: 6px;">▲ Escalated (was <%= @risk.previous_criticality %>)</span>
            <% when 'mitigated' %>
              <span style="color: #16a34a; font-size: 11px; font-weight: bold; margin-left: 6px;">▼ Mitigated (was <%= @risk.previous_criticality %>)</span>
            <% end %>
          </div>
        </div>
        <% if @risk.estimated_cost && @risk.estimated_cost > 0 %>
          <div class="financial-exposure attribute">
            <div class="label">Financial Exposure:</div>
            <div class="value">
              <strong><%= number_to_currency(@risk.estimated_cost) %></strong> (EMV: <span style="color: #c2410c; font-weight: bold;"><%= number_to_currency(@risk.emv) %></span>)
            </div>
          </div>
        <% end %>
      </div>
    </div>
  </div>

  <hr />
  <div class="description">
    <div class="contextual"></div>
    <p><strong><%= l(:field_description) %></strong></p>
    <div class="wiki">
      <%= textilizable @risk, :description %>
    </div>
  </div>

  <% if @risk.treatments.present? %>
    <hr />
    <div class="treatments">
      <p><strong><%= l(:field_treatments) %></strong></p>
      <div class="wiki">
        <%= textilizable @risk, :treatments %>
      </div>
    </div>
  <% end %>

  <% if @risk.lessons.present? %>
    <hr />
    <div class="lessons">
      <p><strong><%= l(:field_lessons) %></strong></p>
      <div class="wiki">
        <%= textilizable @risk, :lessons %>
      </div>
    </div>
  <% end %>
</div>

<hr />
<div id="issue_tree">
  <%= render partial: 'relations' %>
</div>

<% if @journals.present? %>
  <div id="history">
    <h3><%= l(:label_history) %></h3>
    <%= render partial: 'history', locals: { issue: @risk, journals: @journals } rescue nil %>
  </div>
<% end %>
