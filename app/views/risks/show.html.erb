<div class="contextual">
  <%= link_to l(:button_edit), edit_project_risk_path(@risk.project, @risk), class: 'icon icon-edit' if User.current.allowed_to?(:edit_risks, @risk.project) %>
  <%= link_to l(:button_delete), project_risk_path(@risk.project, @risk), method: :delete, data: { confirm: l(:text_are_you_sure) }, class: 'icon icon-del' if User.current.allowed_to?(:delete_risks, @risk.project) %>
</div>

<h2><%= l(:label_risk) %> #<%= @risk.id %></h2>

<div class="issue risk details">
  <div class="subject">
    <h3><%= @risk.title %></h3>
  </div>

  <p class="author">
    <%= authoring @risk.created_at, @risk.user %>.
    <% if @risk.created_at != @risk.updated_at %>
      <%= l(:label_updated_time, time_tag(@risk.updated_at)).html_safe %>.
    <% end %>
  </p>

  <div class="attributes">
    <div class="splitcontent">
      <div class="splitcontentleft">
        <div class="status attribute">
          <div class="label"><%= l(:field_status) %>:</div>
          <div class="value">
            <span class="badge" style="background-color: #<%= @risk.risk_status.color_to_hex %>; color: #fff; padding: 2px 6px; border-radius: 3px;">
              <%= @risk.risk_status.name %>
            </span>
          </div>
        </div>
        <div class="category attribute">
          <div class="label"><%= l(:field_category) %>:</div>
          <div class="value"><%= @risk.category&.name || '-' %></div>
        </div>
        <div class="assigned-to attribute">
          <div class="label"><%= l(:field_assigned_to) %>:</div>
          <div class="value"><%= link_to_user(@risk.assigned_to) if @risk.assigned_to %></div>
        </div>
      </div>
      <div class="splitcontentright">
        <div class="probability attribute">
          <div class="label"><%= l(:field_probability) %>:</div>
          <div class="value"><%= @risk.probability %></div>
        </div>
        <div class="impact attribute">
          <div class="label"><%= l(:field_impact) %>:</div>
          <div class="value"><%= @risk.impact %></div>
        </div>
        <div class="criticality attribute">
          <div class="label"><%= l(:field_criticality) %>:</div>
          <div class="value"><strong><%= @risk.criticality %></strong> (<%= @risk.rationale %>)</div>
        </div>
      </div>
    </div>
  </div>

  <hr />
  <div class="description">
    <div class="contextual"></div>
    <p><strong><%= l(:field_description) %></strong></p>
    <div class="wiki">
      <%= textilizable @risk, :description %>
    </div>
  </div>

  <% if @risk.treatments.present? %>
    <hr />
    <div class="treatments">
      <p><strong><%= l(:field_treatments) %></strong></p>
      <div class="wiki">
        <%= textilizable @risk, :treatments %>
      </div>
    </div>
  <% end %>

  <% if @risk.lessons.present? %>
    <hr />
    <div class="lessons">
      <p><strong><%= l(:field_lessons) %></strong></p>
      <div class="wiki">
        <%= textilizable @risk, :lessons %>
      </div>
    </div>
  <% end %>
</div>

<hr />
<div id="issue_tree">
  <div class="contextual"></div>
  <p><strong><%= l(:label_related_issues) %></strong></p>
  <% if @risk.issues.any? %>
    <table class="list issues">
      <thead>
        <tr>
          <th>#</th>
          <th><%= l(:field_project) %></th>
          <th><%= l(:field_tracker) %></th>
          <th><%= l(:field_subject) %></th>
          <th><%= l(:field_status) %></th>
        </tr>
      </thead>
      <tbody>
        <% @risk.issues.each do |issue| %>
          <tr class="hascontextmenu <%= cycle('odd', 'even') %>">
            <td class="id"><%= link_to issue.id, issue_path(issue) %></td>
            <td class="project"><%= link_to_project(issue.project) %></td>
            <td class="tracker"><%= issue.tracker.name %></td>
            <td class="subject"><%= link_to issue.subject, issue_path(issue) %></td>
            <td class="status"><%= issue.status.name %></td>
          </tr>
        <% end %>
      </tbody>
    </table>
  <% else %>
    <p class="nodata"><%= l(:label_no_data) %></p>
  <% end %>
</div>

<% if @journals.present? %>
  <div id="history">
    <h3><%= l(:label_history) %></h3>
    <%= render partial: 'history', locals: { issue: @risk, journals: @journals } rescue nil %>
  </div>
<% end %>
