<h2><%= l(:label_risk_category) rescue 'Risk Category' %></h2>

<%= labelled_form_for @category, url: (@project ? project_risk_category_path(@project, @category) : risk_category_path(@category)) do |f| %>
  <%= render partial: 'form', locals: { f: f } %>
  <p><%= submit_tag l(:button_save) %></p>
<% end %>
