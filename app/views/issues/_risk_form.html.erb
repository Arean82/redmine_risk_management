<% if @project.module_enabled?(:risks) && User.current.allowed_to?(:edit_risks, @project) %>
  <p>
    <label><%= l(:label_risk_plural) %></label>
    <%= select_tag 'issue[risk_ids][]',
          options_from_collection_for_select(@project.risks.open_risks, :id, :title, @issue.risk_ids),
          multiple: true,
          style: 'width: 95%; max-width: 600px;',
          include_blank: true %>
  </p>
<% end %>
